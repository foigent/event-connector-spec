  },
  "coverage": {
    "included": [
      "authenticated LiteLLM spend-log rows durably visible within complete poll windows whose startTime is at or before the actual inclusive second-precision upstream end_date=floor_second(floor_microsecond(poll time minus 60 seconds))",
      "same-second rows above the current upstream query bound remain eligible for a later overlapping poll because the durable Checkpoint cannot advance beyond the greatest row actually returned",
      "bounded complete HTTP windows with at most 2000 unique request IDs",
      "at most 8 MiB cumulative response bytes per complete poll window"
    ],
    "excluded": [
      "retention, logging or emission of prompt, response, proxy request, API key, user, end-user and IP payloads",
      "rows that become durably visible only after the committed checkpoint has advanced past their startTime, including long-running requests or delayed Source writes beyond the 60-second start-time fence",
      "zero-loss coverage for requests of arbitrary duration without a Source watermark ordered by terminal visibility",
      "windows whose complete pagination cannot be proven"
    ]
  },
  "instance_binding": {
    "source_field": "source_instance",
    "envelope_field": "producer.instance",
    "comparison": "exact_utf8_bytes",
    "change_semantics": "new_connector_instance_identity_domain"
  },
  "payload_policy": {
    "ingestion_capture_mode": "api_import",
    "payload_capture_mode": "metadata_only",
