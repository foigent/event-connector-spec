{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/protocol.ts",
    "./canonical": "./src/canonical/index.ts",
    "./kernel": "./src/kernel/kernel.ts",
    "./testkit": "./src/testkit/report.ts"
  },
  "tasks": {
    "typecheck": "deno check --node-modules-dir=none src/index.ts src/testkit/runner.ts tests/sdk_test.ts",
    "test": "deno test --node-modules-dir=none --allow-read tests",
    "build": "deno cache --node-modules-dir=none --quiet --check --no-remote --no-npm src/index.ts src/testkit/runner.ts"
  },
  "fmt": {
    "lineWidth": 88,
    "indentWidth": 2,
    "semiColons": true
  }
}
