{
  "contract_version": "foigent.connector-conformance.v1",
  "runner": {
    "invocation": "<runner> --bundle <canonical-vector-bundle.json> --report <report.json>",
    "stdout": "nonsecret bounded summary only",
    "report_schema": "foigent://schemas/conformance-report/v1",
    "exit_codes": {
      "0": "all cases passed",
      "2": "invalid bundle or protocol artifact",
      "3": "conformance mismatch",
      "4": "runner internal failure"
    }
  },
  "required_independent_implementations": [
    "go",
    "typescript"
  ],
  "required_case_classes": [
    "canonical_envelope",
    "scoped_idempotency",
    "decimal_boundary",
    "timestamp_normalization",
    "protocol_nfc_rejection",
    "opaque_utf8_preservation",
    "duplicate_key_rejection",
    "capture_gap_derivation",
    "duplicate_noop",
    "content_conflict",
    "partial_page_replay",
    "checkpoint_commit",
    "cursor_error",
    "privacy_rejection"
  ],
  "comparison": {
    "case_id": "<case_class>/<case_id from the canonical vector bundle>",
    "result_encoding": "Every case emits deterministic result bytes. Successful byte-producing cases emit the computed bytes directly. Classifications, expected errors and state transitions emit RFC 8785 canonical JSON bytes of the observed result object.",
    "result_base64": "RFC 4648 standard base64 with padding over exact result bytes",
    "result_sha256": "sha256:<lowercase SHA-256 of exact result bytes>",
    "canonical_bytes": "exact byte equality",
    "digests": "exact lowercase sha256 reference equality",
    "errors": "exact category/code/retryability/recovery equality",
    "reports": "After removing implementation and implementation_version, Go and TypeScript reports have byte-identical RFC 8785 canonical JSON."
  },
  "vector_section_mapping": {
    "canonical_envelopes": [
      "canonical_envelope",
      "capture_gap_derivation"
    ],
    "idempotency": [
      "scoped_idempotency"
    ],
    "decimal_strings": [
      "decimal_boundary"
    ],
    "timestamps": [
      "timestamp_normalization"
    ],
    "unicode": [
      "protocol_nfc_rejection",
      "opaque_utf8_preservation"
    ],
    "strict_json": [
      "duplicate_key_rejection"
    ],
    "replay": [
      "duplicate_noop",
      "content_conflict",
      "partial_page_replay",
      "checkpoint_commit"
    ],
    "golden_fixture_bundle.negative_source_seeds": [
      "cursor_error",
      "privacy_rejection"
    ]
  },
  "safety": {
    "network": "forbidden",
    "credentials": "forbidden",
    "runtime_state": "forbidden",
    "customer_data": "forbidden",
    "fixtures": "immutable offline bundle only"
  }
}
