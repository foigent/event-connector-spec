{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://events/observability/openinference-span-completed/v1",
  "title": "Foigent OpenInference Span Completed Payload V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "terminal",
    "span",
    "trace",
    "model",
    "usage",
    "timeline_complete",
    "capture_gaps"
  ],
  "properties": {
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "const": "LLM"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "span_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "parent_span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "$ref": "#/$defs/nonnegativeInt64"
        },
        "completion_tokens": {
          "$ref": "#/$defs/nonnegativeInt64"
        },
        "total_tokens": {
          "$ref": "#/$defs/nonnegativeInt64"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "timeline_complete": {
      "const": false
    },
    "capture_gaps": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "affected_claim",
          "reason_code",
          "gap_type",
          "severity"
        ],
        "properties": {
          "affected_claim": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 128
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 128
          },
          "gap_type": {
            "const": "not_available_from_source"
          },
          "severity": {
            "const": "warning"
          }
        }
      }
    }
  },
  "$defs": {
    "nonnegativeInt64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$",
      "maxLength": 19
    }
  }
}
