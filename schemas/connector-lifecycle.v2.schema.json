{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://schemas/connector-lifecycle/v2",
  "title": "Foigent Connector Lifecycle V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lifecycle_version",
    "delivery_mode",
    "configuration",
    "authentication",
    "transport",
    "processing",
    "checkpoint",
    "health"
  ],
  "properties": {
    "lifecycle_version": {
      "const": "foigent.connector-lifecycle.v2"
    },
    "delivery_mode": {
      "enum": [
        "https_pull",
        "otlp_http_push",
        "bounded_offline"
      ]
    },
    "configuration": {
      "enum": [
        "unconfigured",
        "configured",
        "retired"
      ]
    },
    "authentication": {
      "enum": [
        "absent",
        "staged",
        "valid",
        "not_applicable",
        "revoked",
        "error"
      ]
    },
    "transport": {
      "enum": [
        "stopped",
        "starting",
        "ready",
        "not_applicable",
        "backoff",
        "error"
      ]
    },
    "processing": {
      "enum": [
        "inactive",
        "idle",
        "polling",
        "receiving",
        "importing",
        "committing",
        "backoff",
        "stopping",
        "error"
      ]
    },
    "checkpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "state"
          ],
          "properties": {
            "applicability": {
              "const": "required"
            },
            "state": {
              "enum": [
                "absent",
                "bootstrap",
                "steady",
                "error"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability"
          ],
          "properties": {
            "applicability": {
              "const": "not_applicable"
            }
          }
        }
      ]
    },
    "health": {
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "permanent_error",
        "stopped",
        "retired"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "delivery_mode": {
            "const": "https_pull"
          }
        },
        "required": [
          "delivery_mode"
        ]
      },
      "then": {
        "properties": {
          "processing": {
            "enum": [
              "inactive",
              "idle",
              "polling",
              "committing",
              "backoff",
              "stopping",
              "error"
            ]
          },
          "checkpoint": {
            "properties": {
              "applicability": {
                "const": "required"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery_mode": {
            "const": "otlp_http_push"
          }
        },
        "required": [
          "delivery_mode"
        ]
      },
      "then": {
        "properties": {
          "processing": {
            "enum": [
              "inactive",
              "idle",
              "receiving",
              "committing",
              "backoff",
              "stopping",
              "error"
            ]
          },
          "checkpoint": {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery_mode": {
            "const": "bounded_offline"
          }
        },
        "required": [
          "delivery_mode"
        ]
      },
      "then": {
        "properties": {
          "processing": {
            "enum": [
              "inactive",
              "idle",
              "importing",
              "committing",
              "stopping",
              "error"
            ]
          },
          "checkpoint": {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          }
        }
      }
    }
  ]
}
