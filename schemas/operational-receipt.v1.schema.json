{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://schemas/operational-receipt/v1",
  "title": "Foigent Connector Operational Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "operation_id",
    "connector_id",
    "producer_instance",
    "operation",
    "status",
    "counts",
    "observed_at"
  ],
  "properties": {
    "receipt_version": {
      "const": "foigent.operational-receipt.v1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "connector_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "producer_instance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "enum": [
        "activate",
        "poll",
        "commit_page",
        "pause",
        "resume",
        "stop",
        "start",
        "rotate",
        "retire"
      ]
    },
    "status": {
      "enum": [
        "accepted",
        "completed",
        "retryable_error",
        "permanent_error"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received",
        "inserted",
        "duplicate_noop",
        "conflict",
        "rejected"
      ],
      "properties": {
        "received": {
          "type": "integer",
          "minimum": 0
        },
        "inserted": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_noop": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkpoint_before": {
      "type": "string",
      "maxLength": 512
    },
    "checkpoint_after": {
      "type": "string",
      "maxLength": 512
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "format": "date-time"
    },
    "error": {
      "$ref": "foigent://schemas/connector-error/v1"
    }
  }
}
