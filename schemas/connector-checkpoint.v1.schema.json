{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://schemas/connector-checkpoint/v1",
  "title": "Foigent Connector Checkpoint V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_version",
    "connector_id",
    "connector_version",
    "producer_instance",
    "cursor",
    "high_watermark",
    "phase",
    "updated_at"
  ],
  "properties": {
    "checkpoint_version": {
      "const": "foigent.connector-checkpoint.v1"
    },
    "connector_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "connector_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "producer_instance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cursor": {
      "type": "string",
      "maxLength": 512
    },
    "high_watermark": {
      "type": "string",
      "maxLength": 512
    },
    "phase": {
      "enum": [
        "bootstrap",
        "steady",
        "error"
      ]
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "format": "date-time"
    }
  }
}
