{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://schemas/conformance-report/v1",
  "title": "Foigent Connector Conformance Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "implementation",
    "implementation_version",
    "bundle_sha256",
    "status",
    "cases"
  ],
  "properties": {
    "report_version": {
      "const": "foigent.conformance-report.v1"
    },
    "implementation": {
      "enum": [
        "go",
        "typescript"
      ]
    },
    "implementation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_class",
          "status",
          "result_kind",
          "result_base64",
          "result_sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "case_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "result_kind": {
            "enum": [
              "bytes",
              "classification",
              "error",
              "state_transition"
            ]
          },
          "result_base64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          },
          "result_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "failure_message": {
            "type": "string",
            "maxLength": 512
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "failure_message"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
