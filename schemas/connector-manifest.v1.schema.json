{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://schemas/connector-manifest/v1",
  "title": "Foigent Connector Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "connector_id",
    "connector_version",
    "connector_class",
    "direction",
    "source_product",
    "event_identity_profile",
    "supported_source_schemas",
    "emitted_event_schemas",
    "transport",
    "delivery",
    "bootstrap",
    "checkpoint",
    "coverage",
    "instance_binding",
    "payload_policy",
    "required_capabilities",
    "declared_capture_gaps",
    "compatibility"
  ],
  "properties": {
    "manifest_version": {
      "const": "foigent.connector-manifest.v1"
    },
    "connector_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 160
    },
    "connector_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "connector_class": {
      "enum": [
        "integration",
        "value",
        "enforcement"
      ]
    },
    "direction": {
      "enum": [
        "source",
        "sink",
        "bidirectional"
      ]
    },
    "source_product": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 64
    },
    "source_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "git_commit",
        "image",
        "platform_manifests",
        "signature"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "index_digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+$",
              "maxLength": 200
            },
            "index_digest": {
              "$ref": "#/$defs/sha256Ref"
            }
          }
        },
        "platform_manifests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "linux_amd64",
            "linux_arm64"
          ],
          "properties": {
            "linux_amd64": {
              "$ref": "#/$defs/sha256Ref"
            },
            "linux_arm64": {
              "$ref": "#/$defs/sha256Ref"
            }
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "public_key_sha256",
            "verified_index_digest"
          ],
          "properties": {
            "scheme": {
              "const": "cosign-key-v1"
            },
            "public_key_sha256": {
              "$ref": "#/$defs/sha256Ref"
            },
            "verified_index_digest": {
              "$ref": "#/$defs/sha256Ref"
            }
          }
        }
      }
    },
    "event_identity_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 200
    },
    "supported_source_schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_id",
          "sha256"
        ],
        "properties": {
          "schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sha256": {
            "$ref": "#/$defs/sha256Ref"
          }
        }
      }
    },
    "emitted_event_schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "schema_ref",
          "schema_version"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "schema_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "schema_version": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "route",
        "page_schema",
        "max_items",
        "max_bytes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "https_pull"
          ]
        },
        "route": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+$",
          "maxLength": 240
        },
        "page_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guarantee",
        "checkpoint_commit",
        "conflict",
        "empty_page_cursor_advance"
      ],
      "properties": {
        "guarantee": {
          "const": "at_least_once"
        },
        "checkpoint_commit": {
          "const": "after_all_items_converge"
        },
        "conflict": {
          "const": "fail_closed"
        },
        "empty_page_cursor_advance": {
          "const": "fail_closed"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "broad_backfill"
      ],
      "properties": {
        "mode": {
          "const": "activation_forward"
        },
        "broad_backfill": {
          "const": false
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "cursor_ownership"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "opaque_cursor",
            "litellm_start_time_boundary_v1"
          ]
        },
        "cursor_ownership": {
          "const": "connector_state_only"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "instance_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_field",
        "envelope_field",
        "comparison",
        "change_semantics"
      ],
      "properties": {
        "source_field": {
          "const": "source_instance"
        },
        "envelope_field": {
          "const": "producer.instance"
        },
        "comparison": {
          "const": "exact_utf8_bytes"
        },
        "change_semantics": {
          "const": "new_connector_instance_identity_domain"
        }
      }
    },
    "payload_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingestion_capture_mode",
        "payload_capture_mode",
        "raw_payload_present"
      ],
      "properties": {
        "ingestion_capture_mode": {
          "const": "api_import"
        },
        "payload_capture_mode": {
          "const": "metadata_only"
        },
        "raw_payload_present": {
          "const": false
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "declared_capture_gaps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "affected_claim",
          "reason_code"
        ],
        "properties": {
          "affected_claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_profile",
        "reference_projection_contract",
        "reference_compatibility_vector_bundle",
        "source_revision",
        "timeline_complete",
        "retention"
      ],
      "properties": {
        "reference_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reference_projection_contract": {
          "$ref": "#/$defs/componentRef"
        },
        "reference_compatibility_vector_bundle": {
          "$ref": "#/$defs/componentRef"
        },
        "source_revision": {
          "const": "1"
        },
        "timeline_complete": {
          "const": true
        },
        "retention": {
          "const": "7d"
        }
      }
    }
  },
  "$defs": {
    "sha256Ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "minLength": 1,
          "maxLength": 240
        },
        "sha256": {
          "$ref": "#/$defs/sha256Ref"
        }
      }
    }
  }
}
