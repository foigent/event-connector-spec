{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://sources/litellm/spend-log/v1",
  "title": "Foigent Sanitized LiteLLM Spend Log V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "start_time",
    "end_time",
    "model",
    "prompt_tokens",
    "completion_tokens",
    "total_tokens",
    "reported_spend",
    "currency",
    "cache_status"
  ],
  "properties": {
    "schema_version": {
      "const": "foigent.litellm.spend-log.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "start_time": {
      "$ref": "#/$defs/microsecondTime"
    },
    "end_time": {
      "$ref": "#/$defs/microsecondTime"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "model_group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "prompt_tokens": {
      "$ref": "#/$defs/int64Decimal"
    },
    "completion_tokens": {
      "$ref": "#/$defs/int64Decimal"
    },
    "total_tokens": {
      "$ref": "#/$defs/int64Decimal"
    },
    "reported_spend": {
      "$ref": "#/$defs/canonicalDecimal"
    },
    "currency": {
      "const": "USD"
    },
    "cache_status": {
      "enum": [
        "hit",
        "miss",
        "unknown"
      ]
    }
  },
  "$defs": {
    "microsecondTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "format": "date-time"
    },
    "int64Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$",
      "maxLength": 19
    },
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*|(0|[1-9][0-9]*)\\.[0-9]*[1-9])$",
      "maxLength": 80
    }
  }
}
