{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foigent://schemas/event-envelope/v1",
  "title": "Foigent Event Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "event_id",
    "event_type",
    "schema_ref",
    "schema_version",
    "producer",
    "scope",
    "subject",
    "actor",
    "time",
    "correlation",
    "identity",
    "integrity",
    "data_policy",
    "provenance",
    "payload"
  ],
  "properties": {
    "spec_version": {
      "const": "foigent.event-envelope.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "schema_ref": {
      "type": "string",
      "pattern": "^foigent://events/[a-z0-9][a-z0-9/_-]*/v[1-9][0-9]*$",
      "maxLength": 200
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 20
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "instance",
        "connector_id",
        "connector_version"
      ],
      "properties": {
        "product": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connector_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$",
          "maxLength": 160
        },
        "connector_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_ref",
        "project_ref"
      ],
      "properties": {
        "tenant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "org_ref": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 20
        },
        "project_ref": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 20
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "system",
            "service",
            "user",
            "unknown"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "on_behalf_of": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurred_at": {
          "$ref": "#/$defs/microsecondTime"
        },
        "observed_at": {
          "$ref": "#/$defs/microsecondTime"
        },
        "terminal_at": {
          "$ref": "#/$defs/microsecondTime"
        }
      },
      "minProperties": 1
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "trace_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "span_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "causation_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "source_revision"
      ],
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/sha256Ref"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_hash"
      ],
      "properties": {
        "source_hash": {
          "$ref": "#/$defs/sha256Ref"
        },
        "envelope_hash": {
          "$ref": "#/$defs/sha256Ref"
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_capture_mode",
        "raw_payload_present"
      ],
      "properties": {
        "payload_capture_mode": {
          "enum": [
            "none",
            "metadata_only",
            "redacted",
            "full"
          ]
        },
        "raw_payload_present": {
          "type": "boolean"
        },
        "redaction_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_fidelity",
        "field_groups"
      ],
      "properties": {
        "adapter_fidelity": {
          "enum": [
            "F0",
            "F1",
            "F2",
            "F3"
          ]
        },
        "field_groups": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "direct",
              "derived",
              "declared",
              "suppressed",
              "gap",
              "not_applicable",
              "unknown"
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256Ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "microsecondTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "format": "date-time"
    }
  }
}
